# Copy to .env and edit. MongoDB is required for normal app runs.
# SECRET_KEY=change-me-to-a-long-random-string      # auto-generated into instance/secret_key if omitted
HG_HOST=127.0.0.1
HG_PORT=5000
HG_MONGO_URI=mongodb://localhost:27017
HG_MONGO_DB=harvestguard_db
# HG_COOKIE_SECURE=1          # set to 1 when served over HTTPS
# HG_SHOW_OTP=1              # LOCAL DEMO ONLY: show the e-mailed OTP on screen when no SMTP is set

# SMTP for the sign-up verification OTP and the forgot-password OTP (e.g. Gmail needs an App Password):
# HG_SMTP_HOST=smtp.gmail.com
# HG_SMTP_PORT=587
# HG_SMTP_USER=you@gmail.com
# HG_SMTP_PASSWORD=your-app-password
# HG_SMTP_FROM=HarvestGuard <you@gmail.com>
